@using HybridCachePlayground.Web.Models
@model HybridCachePlayground.Web.Models.BulkRemoveRequest
@{
    ViewData["Title"] = "Bulk Remove";
    var result     = ViewData["Result"] as BulkRemoveResult;
    var recentKeys = ViewData["RecentKeys"] as List<string> ?? new();
}

<h2 class="mb-1">Bulk Remove</h2>
<p class="text-muted mb-4">
    Remove multiple cache entries at once — by key prefix, explicit key list, or both combined.
</p>

<div class="row g-4">
    <!-- ── Form ── -->
    <div class="col-md-5">
        <div class="card">
            <div class="card-header fw-semibold">Configuration</div>
            <div class="card-body">
                <form asp-action="BulkRemove" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Key Prefix -->
                    <div class="mb-3">
                        <label asp-for="KeyPrefix" class="form-label fw-semibold">
                            Key Prefix <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <input asp-for="KeyPrefix" id="KeyPrefix" class="form-control font-monospace"
                               placeholder="e.g. bulk, user, product" />
                        <span asp-validation-for="KeyPrefix" class="text-danger small"></span>
                        <div class="form-text">
                            Removes all registry keys that start with this prefix (case-insensitive).
                        </div>
                        @if (recentKeys.Any())
                        {
                            <div class="mt-1">
                                <small class="text-muted">Recent: </small>
                                @foreach (var k in recentKeys)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary chip-suggest"
                                            data-fill-id="KeyPrefix" data-fill-val="@k">@k</button>
                                }
                            </div>
                        }
                    </div>

                    <div class="text-center text-muted small mb-3">— or —</div>

                    <!-- Explicit Keys -->
                    <div class="mb-4">
                        <label asp-for="Keys" class="form-label fw-semibold">
                            Explicit Keys <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <textarea asp-for="Keys" id="Keys" class="form-control font-monospace" rows="5"
                                  placeholder="user:1, user:2&#10;product:42&#10;session:abc"></textarea>
                        <span asp-validation-for="Keys" class="text-danger small"></span>
                        <div class="form-text">Comma- or newline-separated keys. Combines with prefix above.</div>
                        @if (recentKeys.Any())
                        {
                            <div class="mt-1">
                                <small class="text-muted">Add from recent: </small>
                                @foreach (var k in recentKeys)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary chip-suggest chip-key"
                                            data-fill-id="Keys" data-fill-val="@k">@k</button>
                                }
                            </div>
                        }
                    </div>

                    <button type="submit" class="btn btn-danger w-100">
                        <i class="bi bi-trash3 me-1"></i>Remove Entries
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- ── Results ── -->
    <div class="col-md-7">
        @if (result is not null)
        {
            if (result.Removed == 0)
            {
                <div class="alert alert-warning d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle fs-5"></i>
                    <span>No matching entries found — nothing was removed.</span>
                </div>
            }
            else
            {
                <div class="card border-danger mb-3">
                    <div class="card-header bg-danger text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-trash3 me-1"></i>@result.Removed @(result.Removed == 1 ? "entry" : "entries") removed</span>
                        <span class="small fw-normal">@result.ElapsedMs ms</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive" style="max-height:480px; overflow-y:auto;">
                            <table class="table table-sm table-bordered align-middle mb-0">
                                <thead class="table-dark" style="position:sticky;top:0;z-index:1;">
                                    <tr>
                                        <th style="width:36px">#</th>
                                        <th>Key</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < result.Keys.Count; i++)
                                    {
                                        <tr>
                                            <td class="text-muted small text-center">@(i + 1)</td>
                                            <td><code class="small">@result.Keys[i]</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="card h-100" style="border-color:#2d3139; min-height:200px;">
                <div class="card-body d-flex align-items-center justify-content-center text-muted">
                    <div class="text-center">
                        <i class="bi bi-trash3 fs-1 mb-2 d-block"></i>
                        <p>Fill in the form and click <strong>Remove Entries</strong>.</p>
                        <p class="small mb-0">
                            Results will appear here with a list of all removed keys.
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    document.querySelectorAll('[data-fill-id]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var inputId = btn.getAttribute('data-fill-id');
            var val     = btn.getAttribute('data-fill-val');
            var el      = document.getElementById(inputId);
            if (!el) return;
            if (btn.classList.contains('chip-key')) {
                // Append key to textarea if not already present
                var parts = el.value.split(/[\n,]/).map(function(s) { return s.trim(); }).filter(Boolean);
                if (!parts.includes(val)) { parts.push(val); }
                el.value = parts.join('\n');
            } else {
                el.value = val;
            }
        });
    });
    </script>
}
