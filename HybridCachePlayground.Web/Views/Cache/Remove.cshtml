@model HybridCachePlayground.Web.Models.CacheRemoveRequest
@{
    ViewData["Title"] = "Remove by Key";
    var recentKeys = ViewData["RecentKeys"] as List<string> ?? new();
}

<h2 class="mb-4">Remove by Key</h2>
<p class="text-muted">
    Evicts a single entry from both L1 and L2 using
    <code>HybridCache.RemoveAsync(key)</code>.
</p>

<div class="row g-4">
    <div class="col-md-7">

        <!-- Single remove -->
        <div class="card mb-4">
            <div class="card-header fw-semibold">Single Key</div>
            <div class="card-body">
                <form asp-action="Remove" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Key" class="form-label fw-semibold">Cache Key</label>
                        <input asp-for="Key" id="Key" class="form-control" placeholder="e.g. user:42" />
                        <span asp-validation-for="Key" class="text-danger small"></span>
                        @if (recentKeys.Any())
                        {
                            <div class="mt-1">
                                <small class="text-muted">Recent: </small>
                                @foreach (var k in recentKeys)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary chip-suggest"
                                            data-fill-id="Key" data-fill-val="@k">@k</button>
                                }
                            </div>
                        }
                    </div>
                    <button type="submit" class="btn btn-danger">Remove Entry</button>
                </form>
            </div>
        </div>

        <!-- Bulk remove -->
        <div class="card border-danger">
            <div class="card-header fw-semibold">Bulk Remove Keys</div>
            <div class="card-body">
                <form asp-action="BulkRemoveKeys" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="keys" class="form-label fw-semibold">Keys</label>
                        <textarea id="keys" name="keys" class="form-control font-monospace" rows="6"
                                  placeholder="user:1&#10;user:2&#10;product:42&#10;&#10;or comma-separated: user:1, user:2"></textarea>
                        <div class="form-text">One key per line, or comma-separated. Duplicates are ignored.</div>
                        @if (recentKeys.Any())
                        {
                            <div class="mt-1">
                                <small class="text-muted">Add from recent: </small>
                                @foreach (var k in recentKeys)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-secondary chip-key"
                                            data-val="@k">@k</button>
                                }
                            </div>
                        }
                    </div>
                    <button type="submit" class="btn btn-danger">Remove All</button>
                </form>
            </div>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-link mt-3">Back to Dashboard</a>
    </div>

    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-secondary small">API used</div>
            <div class="card-body">
                <pre class="small mb-0"><code>await hybridCache.RemoveAsync(key);</code></pre>
            </div>
        </div>
        <div class="card border-warning mt-3">
            <div class="card-header bg-warning small">Note</div>
            <div class="card-body small">
                <code>RemoveAsync</code> evicts from <strong>both</strong> L1 (in-process)
                and L2 (distributed). On multi-server setups, all nodes are invalidated
                when using a distributed L2 backend.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
    document.querySelectorAll('[data-fill-id]').forEach(function (btn) {
        btn.addEventListener('click', function () {
            document.getElementById(btn.getAttribute('data-fill-id')).value = btn.getAttribute('data-fill-val');
        });
    });

    document.querySelectorAll('.chip-key').forEach(function (btn) {
        btn.addEventListener('click', function () {
            var ta = document.getElementById('keys');
            var val = btn.getAttribute('data-val');
            var parts = ta.value.split(/[\n,]/).map(function(s){ return s.trim(); }).filter(Boolean);
            if (!parts.includes(val)) parts.push(val);
            ta.value = parts.join('\n');
        });
    });
    </script>
}
